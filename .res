$tmer CHAL336/CHAL-CHAL-7/$f  CHAL336/CHAL-CHAL-7_MA/$f  CHAL336/CHAL-CHAL-7_MB/$f  x  1  -1  -1  $w -20.14  #   7  CHAL-CHAL-7   O3Te···SeHF         -20.14  C
$tmer CHAL336/CHAL-CHAL-8/$f  CHAL336/CHAL-CHAL-8_MA/$f  CHAL336/CHAL-CHAL-8_MB/$f  x  1  -1  -1  $w -19.76  #   8  CHAL-CHAL-8   O3Te···TeH2         -19.76  C
