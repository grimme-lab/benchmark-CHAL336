#!/bin/bash

# CHAL336 Benchmark by Goerigk et al.
# J. Chem. Theory Comput. 2021, 17, 2783-2806, https://doi.org/10.1021/acs.jctc.1c00006
# Reference values were calculated using different strategies (A, B, C, D, E, W1-F12)
# for DLPNO-CCSD(T). For detailed information check the original publication.

tmer=${TMER:-tmer2++}

f=$1        # Method name (name of subdir containing energy/coordinate files)
w=${2:-0}   # Method index (defaults to 0: turbomole energy file)

$tmer CHAL336/CHAL-CHAL-1/$f  CHAL336/CHAL-CHAL-1_MA/$f  CHAL336/CHAL-CHAL-1_MB/$f  x  1  -1  -1  $w -34.18  #   1  CHAL-CHAL-1   O3Te···TeHF         -34.18  Ca
$tmer CHAL336/CHAL-CHAL-2/$f  CHAL336/CHAL-CHAL-2_MA/$f  CHAL336/CHAL-CHAL-2_MB/$f  x  1  -1  -1  $w -30.72  #   2  CHAL-CHAL-2   O3Te···TeHOCH3      -30.72  C
$tmer CHAL336/CHAL-CHAL-3/$f  CHAL336/CHAL-CHAL-3_MA/$f  CHAL336/CHAL-CHAL-3_MB/$f  x  1  -1  -1  $w -26.28  #   3  CHAL-CHAL-3   O3Te···TeHCl        -26.28  C
$tmer CHAL336/CHAL-CHAL-4/$f  CHAL336/CHAL-CHAL-4_MA/$f  CHAL336/CHAL-CHAL-4_MB/$f  x  1  -1  -1  $w -25.69  #   4  CHAL-CHAL-4   O3Se···TeHF         -25.69  C
